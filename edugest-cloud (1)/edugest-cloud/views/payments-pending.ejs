<%- include('partials/header') %>
<h1 class="h3 page-title mb-3">Paiements en attente</h1>
<div class="card mb-4"><div class="card-header">Paiements enregistrés « en attente »</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Échéance</th><th>Élève</th><th>Motif</th><th>Montant</th><th></th></tr></thead><tbody>
<% if (!pending.length) { %><tr><td colspan="5" class="text-muted text-center py-3">Aucun paiement en attente.</td></tr><% } %>
<% pending.forEach(p => { %><tr><td><%= fmtDate(p.date_paiement) %></td><td><%= p.prenom %> <%= p.nom %> (<%= p.classe %>)</td><td><%= p.motif || '' %></td><td><%= money(p.montant) %></td>
<td class="text-end"><form method="post" action="/payments/<%= p.id %>/validate" class="d-inline" data-confirm="Marquer ce paiement comme reçu ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-success"><i class="bi bi-check2-circle"></i> Valider</button></form></td></tr><% }) %></tbody></table></div></div>
<div class="card"><div class="card-header">Soldes restants par élève</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Élève</th><th>Classe</th><th>Frais</th><th>Payé</th><th>Reste à payer</th><th></th></tr></thead><tbody>
<% if (!balances.length) { %><tr><td colspan="6" class="text-muted text-center py-3">Tous les élèves sont à jour.</td></tr><% } %>
<% balances.forEach(b => { %><tr><td><%= b.nom %> <%= b.prenom %></td><td><%= b.classe %></td><td><%= money(b.frais) %></td><td><%= money(b.paye) %></td><td><strong><%= money(b.solde) %></strong></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/payments/new?student_id=<%= b.id %>">Encaisser</a></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/footer') %>
