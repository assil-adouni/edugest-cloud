<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 page-title mb-0">Messagerie</h1><a class="btn btn-primary" href="/messages/new"><i class="bi bi-pencil-square"></i> Nouveau message</a></div>
<ul class="nav nav-tabs mb-3"><li class="nav-item"><a class="nav-link <%= box === 'inbox' ? 'active' : '' %>" href="/messages">Boîte de réception</a></li><li class="nav-item"><a class="nav-link <%= box === 'sent' ? 'active' : '' %>" href="/messages?box=sent">Envoyés</a></li></ul>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Expéditeur</th><th>Destinataire</th><th>Objet</th><th>Date</th></tr></thead><tbody>
<% if (!rows.length) { %><tr><td colspan="4" class="text-center text-muted py-4">Aucun message.</td></tr><% } %>
<% rows.forEach(m => { %><tr class="<%= box === 'inbox' && !m.is_read ? 'fw-bold' : '' %>"><td><%= m.expediteur %></td><td><%= m.destinataire %></td><td><a href="/messages/<%= m.id %>"><%= m.objet %></a></td><td class="text-nowrap"><%= fmtDateTime(m.created_at) %></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/footer') %>
