<%- include('partials/header') %>
<h1 class="h3 page-title mb-3"><%= title %></h1>
<%- include('partials/errors') %>
<form method="post" action="<%= action %>" class="card card-body">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="row g-3">
  <% fields.forEach(f => { const v = f.type === 'password' ? '' : (values[f.name] ?? ''); %>
    <div class="col-md-<%= f.col || 6 %>">
      <label class="form-label" for="<%= f.name %>"><%= f.label %><%= f.required ? ' *' : '' %></label>
      <% if (f.type === 'select') { %>
        <select class="form-select" id="<%= f.name %>" name="<%= f.name %>" <%= f.required ? 'required' : '' %>>
          <option value="">— Choisir —</option>
          <% f.options.forEach(o => { %><option value="<%= o.value %>" <%= String(v) === String(o.value) ? 'selected' : '' %>><%= o.label %></option><% }) %>
        </select>
      <% } else { %>
        <input class="form-control" id="<%= f.name %>" name="<%= f.name %>" type="<%= f.type || 'text' %>" value="<%= v %>" <%= f.required ? 'required' : '' %>
          <% if (f.maxlength) { %>maxlength="<%= f.maxlength %>"<% } %> <% if (f.minlength) { %>minlength="<%= f.minlength %>"<% } %>
          <% if (f.min !== undefined) { %>min="<%= f.min %>"<% } %> <% if (f.max !== undefined) { %>max="<%= f.max %>"<% } %>
          <% if (f.step) { %>step="<%= f.step %>"<% } %> <% if (f.placeholder) { %>placeholder="<%= f.placeholder %>"<% } %>>
      <% } %>
    </div>
  <% }) %>
  </div>
  <div class="mt-4"><button class="btn btn-primary"><i class="bi bi-check-lg"></i> Enregistrer</button> <a class="btn btn-outline-secondary" href="<%= cancelUrl %>">Annuler</a></div>
</form>
<%- include('partials/footer') %>
