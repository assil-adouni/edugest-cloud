<%- include('partials/header') %>
<h1 class="h3 page-title mb-3">Notes</h1>
<form method="get" class="card card-body mb-3"><div class="row g-2 align-items-end">
  <div class="col-md-4"><label class="form-label">Classe</label><select class="form-select" name="class_id" required><option value="">— Choisir —</option>
    <% classes.forEach(c => { %><option value="<%= c.id %>" <%= String(c.id) === q.class_id ? 'selected' : '' %>><%= c.nom %></option><% }) %></select></div>
  <div class="col-md-4"><label class="form-label">Matière</label><select class="form-select" name="subject_id" required><option value="">— Choisir —</option>
    <% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(s.id) === q.subject_id ? 'selected' : '' %>><%= s.nom %> (coef. <%= s.coefficient %>)</option><% }) %></select></div>
  <div class="col-md-2"><label class="form-label">Trimestre</label><select class="form-select" name="trimestre"><% ['1','2','3'].forEach(t => { %><option <%= q.trimestre === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div>
  <div class="col-md-2"><button class="btn btn-primary w-100">Afficher</button></div></div>
  <% if (!classes.length) { %><p class="text-muted mt-3 mb-0">Aucune classe ne vous est affectée pour <%= ANNEE %>.</p><% } %></form>
<% if (students) { %>
<form method="post" action="/grades" class="card">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="class_id" value="<%= q.class_id %>"><input type="hidden" name="subject_id" value="<%= q.subject_id %>"><input type="hidden" name="trimestre" value="<%= q.trimestre %>">
  <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Élève</th><th style="width:160px">Note (/20)</th><th>Moyenne du trimestre (pondérée)</th><th></th></tr></thead><tbody>
  <% if (!students.length) { %><tr><td colspan="4" class="text-muted text-center py-4">Aucun élève dans cette classe.</td></tr><% } %>
  <% students.forEach(s => { %><tr><td><%= s.nom %> <%= s.prenom %></td>
    <td><input class="form-control" name="note_<%= s.id %>" type="number" min="0" max="20" step="0.25" value="<%= s.valeur ?? '' %>" <%= canEdit ? '' : 'disabled' %>></td>
    <td><%= s.moyenne === null ? '—' : s.moyenne + ' / 20' %></td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/bulletin/<%= s.id %>">Bulletin</a></td></tr><% }) %>
  </tbody></table></div>
  <% if (canEdit && students.length) { %><div class="card-footer"><button class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer les notes</button> <span class="text-muted small ms-2">Une case vide supprime la note.</span></div><% } else if (!canEdit) { %><div class="card-footer text-muted small">Consultation seule : la saisie est réservée aux enseignants.</div><% } %>
</form>
<% } %>
<%- include('partials/footer') %>
