<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h1 class="h3 page-title mb-0">Emploi du temps</h1>
<% if (classes.length > 1) { %><form method="get" class="d-flex gap-2"><select class="form-select" name="class_id" onchange="this.form.submit()"><% classes.forEach(c => { %><option value="<%= c.id %>" <%= cls && cls.id === c.id ? 'selected' : '' %>><%= c.nom %></option><% }) %></select><noscript><button class="btn btn-outline-primary">Afficher</button></noscript></form><% } %></div>
<% if (!cls) { %><div class="card card-body text-muted text-center">Aucune classe à afficher.</div><% } else { %>
<p class="text-muted">Classe : <strong><%= cls.nom %></strong></p>
<%- include('partials/errors') %>
<div class="row g-3 mb-4">
<% Object.entries(JOURS).forEach(([j, nom]) => { const list = slots.filter(s => String(s.jour) === j); %>
<div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-header"><%= nom %></div><ul class="list-group list-group-flush">
<% if (!list.length) { %><li class="list-group-item text-muted small">Pas de cours</li><% } %>
<% list.forEach(s => { %><li class="list-group-item d-flex justify-content-between gap-2"><div><strong><%= s.heure_debut.slice(0,5) %> – <%= s.heure_fin.slice(0,5) %></strong> · <%= s.matiere %><br><small class="text-muted"><%= s.salle || 'Salle non définie' %><%= s.enseignant ? ' · ' + s.enseignant : '' %></small></div>
<% if (canEdit) { %><form method="post" action="/timetable/<%= s.id %>/delete" data-confirm="Supprimer ce cours ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></button></form><% } %></li><% }) %>
</ul></div></div><% }) %></div>
<% if (canEdit) { %>
<form method="post" action="/timetable" class="card card-body"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="class_id" value="<%= cls.id %>">
<div class="fw-semibold mb-2">Ajouter un cours à la classe <%= cls.nom %></div><div class="row g-3">
<div class="col-md-3"><label class="form-label">Jour *</label><select class="form-select" name="jour" required><option value="">— Choisir —</option><% Object.entries(JOURS).forEach(([j, n]) => { %><option value="<%= j %>" <%= String(v.jour) === j ? 'selected' : '' %>><%= n %></option><% }) %></select></div>
<div class="col-md-2"><label class="form-label">Début *</label><input class="form-control" type="time" name="heure_debut" required value="<%= v.heure_debut || '' %>"></div>
<div class="col-md-2"><label class="form-label">Fin *</label><input class="form-control" type="time" name="heure_fin" required value="<%= v.heure_fin || '' %>"></div>
<div class="col-md-3"><label class="form-label">Matière *</label><select class="form-select" name="subject_id" required><option value="">— Choisir —</option><% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(v.subject_id) === String(s.id) ? 'selected' : '' %>><%= s.nom %></option><% }) %></select></div>
<div class="col-md-2"><label class="form-label">Salle</label><select class="form-select" name="room_id"><option value="">Salle de la classe</option><% rooms.forEach(r => { %><option value="<%= r.id %>"><%= r.nom %></option><% }) %></select></div>
</div><div class="mt-3"><button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Ajouter le cours</button> <span class="text-muted small ms-2">Les conflits (classe, salle, enseignant) sont détectés automatiquement.</span></div></form>
<% } %><% } %>
<%- include('partials/footer') %>
