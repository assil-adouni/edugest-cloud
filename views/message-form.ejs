<%- include('partials/header') %>
<h1 class="h3 page-title mb-3"><%= editMode ? 'Modifier le message' : 'Nouveau message' %></h1>
<%- include('partials/errors') %>
<form method="post" action="<%= editMode ? '/messages/' + m.id + '/edit' : '/messages' %>" class="card card-body"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (editMode) { %><p class="text-muted">Destinataire : <strong><%= m.destinataire %></strong>. Le destinataire verra le message comme nouveau après modification.</p>
  <% } else { %><label class="form-label">Destinataire *</label><select class="form-select mb-3" name="recipient_id" required><option value="">— Choisir —</option>
  <% groups.forEach(g => { %><optgroup label="<%= g.label %>"><% g.options.forEach(r => { %><option value="<%= r.value %>" <%= String(r.value) === String(v.recipient_id) ? 'selected' : '' %>><%= r.label %></option><% }) %></optgroup><% }) %></select><% } %>
  <label class="form-label">Objet *</label><input class="form-control mb-3" name="objet" maxlength="150" required value="<%= v.objet %>">
  <label class="form-label">Message *</label><textarea class="form-control mb-3" name="contenu" rows="6" maxlength="5000" required><%= v.contenu %></textarea>
  <div><button class="btn btn-primary"><i class="bi bi-send"></i> <%= editMode ? 'Enregistrer' : 'Envoyer' %></button> <a class="btn btn-outline-secondary" href="/messages">Annuler</a></div></form>
<%- include('partials/footer') %>
