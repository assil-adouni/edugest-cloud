<%- include('partials/header') %>
<h1 class="h3 page-title mb-3">Devoirs</h1>
<% if (user.role === 'enseignant') { %>
<%- include('partials/errors') %>
<form method="post" action="/homework?_csrf=<%= csrf %>" enctype="multipart/form-data" class="card card-body mb-4"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="fw-semibold mb-2">Publier un devoir</div><div class="row g-3">
  <div class="col-md-4"><label class="form-label">Classe *</label><select class="form-select" name="class_id" required><option value="">— Choisir —</option><% classes.forEach(c => { %><option value="<%= c.id %>" <%= String(c.id) === String(v.class_id) ? 'selected' : '' %>><%= c.nom %></option><% }) %></select></div>
  <div class="col-md-4"><label class="form-label">Matière *</label><select class="form-select" name="subject_id" required><option value="">— Choisir —</option><% subjects.forEach(s => { %><option value="<%= s.id %>" <%= String(s.id) === String(v.subject_id) ? 'selected' : '' %>><%= s.nom %></option><% }) %></select></div>
  <div class="col-md-4"><label class="form-label">Date limite *</label><input class="form-control" type="date" name="date_limite" required value="<%= v.date_limite || '' %>"></div>
  <div class="col-12"><label class="form-label">Titre *</label><input class="form-control" name="titre" maxlength="150" required value="<%= v.titre || '' %>"></div>
  <div class="col-12"><label class="form-label">Description *</label><textarea class="form-control" name="description" rows="3" maxlength="3000" required><%= v.description || '' %></textarea></div>
  <div class="col-12"><label class="form-label">Fichiers joints (optionnel)</label><input class="form-control" type="file" name="files" multiple accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt"><div class="form-text">3 fichiers maximum, 5 Mo chacun (PDF, images, Word, Excel, PowerPoint, texte).</div></div>
</div><div class="mt-3"><button class="btn btn-primary"><i class="bi bi-send"></i> Publier</button></div></form>
<% } %>
<div class="row g-3">
<% if (!rows.length) { %><div class="col-12"><div class="card card-body text-muted text-center">Aucun devoir pour le moment.</div></div><% } %>
<% rows.forEach(h => { %><div class="col-md-6"><div class="card h-100"><div class="card-body">
  <div class="d-flex justify-content-between"><h2 class="h6"><%= h.titre %></h2><span class="badge bg-info-subtle text-info-emphasis"><%= h.matiere %></span></div>
  <p class="small mb-2" style="white-space:pre-line"><%= h.description %></p>
  <% if (h.files.length) { %><div class="mb-2"><% h.files.forEach(f => { %><a class="btn btn-sm btn-outline-primary me-1 mb-1" href="/homework/files/<%= f.id %>"><i class="bi bi-paperclip"></i> <%= f.filename %> <small>(<%= Math.max(1, Math.round(f.size / 1024)) %> Ko)</small></a><% }) %></div><% } %>
  <div class="small text-muted"><%= h.classe %> · <%= h.enseignant || '' %><br>À rendre le <strong><%= fmtDate(h.date_limite) %></strong></div></div>
  <% if (user.role !== 'parent') { %><div class="card-footer text-end"><form method="post" action="/homework/<%= h.id %>/delete" class="d-inline" data-confirm="Supprimer ce devoir ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Supprimer</button></form></div><% } %>
</div></div><% }) %></div>
<%- include('partials/footer') %>
