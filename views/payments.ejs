<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><h1 class="h3 page-title mb-0">Paiements</h1>
<a class="btn btn-primary" href="/payments/new"><i class="bi bi-plus-lg"></i> Enregistrer un paiement</a></div>
<div class="row g-3 mb-3">
  <div class="col-md-4"><div class="stat-card ok"><i class="bi bi-cash-coin"></i><div><div class="stat-value"><%= money(totals.paye) %></div><div class="stat-label">Total payé (<%= ANNEE %>)</div></div></div></div>
  <div class="col-md-4"><div class="stat-card warn"><i class="bi bi-wallet2"></i><div><div class="stat-value"><%= money(totals.solde) %></div><div class="stat-label">Solde restant à payer</div></div></div></div>
  <div class="col-md-4"><div class="stat-card warn"><i class="bi bi-hourglass-split"></i><div><div class="stat-value"><%= money(totals.attente) %></div><div class="stat-label">Paiements en attente</div></div></div></div>
</div>
<form class="row g-2 mb-3" method="get"><div class="col-md-5"><input class="form-control" name="q" value="<%= q %>" placeholder="Rechercher un élève…"></div>
<div class="col-md-3"><select class="form-select" name="statut"><option value="">Tous les statuts</option><option value="paye" <%= statut === 'paye' ? 'selected' : '' %>>Payé</option><option value="en_attente" <%= statut === 'en_attente' ? 'selected' : '' %>>En attente</option></select></div>
<div class="col-auto"><button class="btn btn-outline-primary">Filtrer</button></div></form>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Date</th><th>Élève</th><th>Classe</th><th>Motif</th><th>Mode</th><th>Montant</th><th>Statut</th></tr></thead><tbody>
<% if (!payments.length) { %><tr><td colspan="7" class="text-center text-muted py-4">Aucun paiement.</td></tr><% } %>
<% payments.forEach(p => { %><tr><td><%= fmtDate(p.date_paiement) %></td><td><%= p.prenom %> <%= p.nom %></td><td><%= p.classe %></td><td><%= p.motif || '' %></td><td><%= MODES[p.mode] %></td><td><%= money(p.montant) %></td>
<td><span class="badge <%= p.statut === 'paye' ? 'bg-success' : 'bg-warning text-dark' %>"><%= p.statut === 'paye' ? 'Payé' : 'En attente' %></span></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/footer') %>
