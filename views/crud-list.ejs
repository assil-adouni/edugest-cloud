<%- include('partials/header') %>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <h1 class="h3 page-title mb-0"><%= title %></h1>
  <% if (locals.addUrl) { %><a class="btn btn-primary" href="<%= addUrl %>"><i class="bi bi-plus-lg"></i> <%= addLabel || 'Ajouter' %></a><% } %>
</div>
<% if (locals.search) { %>
<form class="row g-2 mb-3" method="get"><div class="col-sm-8 col-md-5"><input class="form-control" name="q" value="<%= locals.q || '' %>" placeholder="Rechercher par nom, prénom ou classe…"></div>
<div class="col-auto"><button class="btn btn-outline-primary"><i class="bi bi-search"></i> Rechercher</button> <% if (locals.q) { %><a class="btn btn-link" href="?">Effacer</a><% } %></div></form>
<% } %>
<div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
<thead><tr><% columns.forEach(c => { %><th><%= c.label %></th><% }) %><th class="text-end">Actions</th></tr></thead>
<tbody>
<% if (!rows.length) { %><tr><td colspan="<%= columns.length + 1 %>" class="text-center text-muted py-4">Aucun résultat.</td></tr><% } %>
<% rows.forEach(r => { %><tr>
  <% columns.forEach(c => { %><td><%= c.fmt ? c.fmt(r[c.key], r) : (r[c.key] ?? '') %></td><% }) %>
  <td class="text-end text-nowrap">
    <% (locals.extra || []).forEach(x => { %><a class="btn btn-sm btn-outline-secondary" href="<%= x.href(r) %>"><i class="bi bi-<%= x.icon %>"></i> <%= x.label %></a> <% }) %>
    <% if (locals.editUrl) { %><a class="btn btn-sm btn-outline-primary" href="<%= editUrl(r) %>"><i class="bi bi-pencil"></i> Modifier</a> <% } %>
    <% if (locals.deleteUrl) { %><form method="post" action="<%= deleteUrl(r) %>" class="d-inline" data-confirm="<%= deleteMsg(r) %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Supprimer</button></form><% } %>
  </td></tr><% }) %>
</tbody></table></div></div>
<%- include('partials/footer') %>
