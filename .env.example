# Copiez ce fichier en ".env" et adaptez les valeurs (ne commitez JAMAIS .env)
PORT=3000
NODE_ENV=development
# Connexion PostgreSQL (format : postgresql://utilisateur:motdepasse@hote:5432/nom_base)
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/edugest
# "true" uniquement si la base exige SSL (URL externe Render/Railway). Inutile en local ou avec l'URL interne.
DATABASE_SSL=false
# Chaîne aléatoire longue (obligatoire en production)
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Année scolaire courante
ANNEE_SCOLAIRE=2026-2027
# Crée les tables au démarrage et insère les données fictives si la base est vide
AUTO_INIT_DB=true
SEED_DEMO_DATA=true
